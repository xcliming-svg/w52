static func get_week(at_week: int) -> Dictionary:
    return (SCENES.get(at_week, {}) as Dictionary).duplicate(true)

static func cards(at_week: int, section: String, context: Dictionary = {}) -> Array[Dictionary]:
    if section not in ["intro", "post"]:
        return []
    var scene: Dictionary = get_week(at_week)
    var result: Array[Dictionary] = []
    for item in scene.get("intro_cards" if section == "intro" else "post_win_cards", []):
        result.append((item as Dictionary).duplicate(true))
    if section == "post":
        result.append({"speaker":"root", "text":"회수 단서 %s: %s" % [
            str(scene.get("evidence_id", "")), str(scene.get("evidence_description", ""))]})
    var conditional := ""
    var alternate := ""
    if section == "intro" and at_week == 9:
        conditional = "우리도 차체를 만들 준비는 됐어요."
        alternate = "도면은 확보했지만 건설은 지휘관이 결정해야 합니다."
        result.append({"speaker":"maya", "text":conditional if context.get("walker_owned", false) else alternate})
    elif section == "intro" and at_week == 15:
        result.append({"speaker":"maya", "text":"우리 격납고의 탐지 기록과 비교하죠." if context.get("hangar_owned", false) else "적기 기록만으로 출처를 추적하죠."})
    elif section == "post" and at_week == 18:
        result.append({"speaker":"maya", "text":"적 경로 좌표가 W17 실제 배치와 일치해요." if context.get("previous_match", false) else "우리 작전의 일부가 기록돼 있어요. 좌표 일치는 아직 확인하지 못했어요."})
    elif section == "post" and at_week == 19:
        result.append({"speaker":"maya", "text":"우리 전차의 출전 기록과는 별개로, 폐기된 설계가 유출됐어요." if context.get("tank_deployed", false) else "지금 전차를 출전시켰다고 가정할 수는 없어요. 폐기된 초안의 오류만 확인했어요."})
    elif section == "post" and at_week == 26:
        result.append({"speaker":"root", "text":"현재 출전 배치와 적 파일의 같은 좌표가 확인됐습니다." if context.get("current_match", false) else "준비 자료의 전송 시각만 확인됐습니다. 배치 좌표 유출은 미확인입니다."})
    elif section == "post" and at_week == 38:
        result.append({"speaker":"root", "text":"적 초기 진형과 미끼 계획 좌표의 일치가 검증됐습니다." if context.get("decoy_a_match", false) else "미끼 계획과 일치하는 적 초기 진형의 반응은 아직 검증되지 않았습니다."})
    elif section == "post" and at_week == 39:
        result.append({"speaker":"root", "text":"초기 진형은 A에만 부합하며 B와는 일치하지 않습니다." if context.get("decoy_split_match", false) else "A에만 반응한 적 진형은 검증되지 않았습니다. 경로 사용자는 미확정입니다."})
    return result

static func legacy_demo_cards(at_week: int) -> Array[Dictionary]:
    # Old v2-v4 dialogue was a five-card demonstration, not v9 canon.
    var result: Array[Dictionary] = []
    if at_week == 1:
        for line in [
            "52주 동안 주마다 한 차례 전투를 준비합니다.",
            "왼쪽의 노드에서 사용할 전략을 살펴보세요.",
            "소총병 경로를 선택해 전장 정보를 확인할 수 있습니다.",
